# npm 10.9.7 (bundled with Node 22.22) has a bug in peer-dependency
# resolution (Arborist `loadPeerSet` -> "Cannot read properties of null
# (reading 'edgesOut')") that breaks `npm install` and `npm ci` against the
# Angular 21 + vitest dependency tree. Disabling automatic peer resolution
# makes both commands work and keeps package-lock.json consistent.
legacy-peer-deps=true
